{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sensor Point Annotation",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["time_ms", "class_key"],
    "properties": {
      "time_ms":    { "type": "number" },
      "channel":    { "type": "string" },
      "class_key":  { "type": "string" },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "additionalProperties": false
  }
}
