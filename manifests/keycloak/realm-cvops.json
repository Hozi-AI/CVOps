{
  "realm": "cvops",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "cvops-edge",
      "name": "CVOps edge (oauth2-proxy)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CVOPS_EDGE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "cvops-edge-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cvops-edge",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": "${CVOPS_GOOGLE_IDP_ENABLED}",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${CVOPS_GOOGLE_CLIENT_ID}",
        "clientSecret": "${CVOPS_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": "${CVOPS_GITHUB_IDP_ENABLED}",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${CVOPS_GITHUB_CLIENT_ID}",
        "clientSecret": "${CVOPS_GITHUB_CLIENT_SECRET}",
        "defaultScope": "user:email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Dev",
      "credentials": [
        { "type": "password", "value": "${CVOPS_SEED_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Dev",
      "credentials": [
        { "type": "password", "value": "${CVOPS_SEED_USER_PASSWORD}", "temporary": false }
      ]
    }
  ]
}
