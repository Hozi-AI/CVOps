# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=cvops
POSTGRES_USER=cvops
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── Garage S3 (object store) ─────────────────────────────────────────────
# Garage docs: https://garagehq.deuxfleurs.fr/
# Access key must start with "GK":  echo "GK$(openssl rand -hex 12)"
GARAGE_DEFAULT_ACCESS_KEY=
# Generate with: openssl rand -hex 32
GARAGE_DEFAULT_SECRET_KEY=
GARAGE_DEFAULT_BUCKET=cvops-blobs
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Generate with: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=
# Generate with: openssl rand -hex 32
GARAGE_METRICS_TOKEN=

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Host port bindings ───────────────────────────────────────────────────
# Where docker-compose publishes infra/edge ports on your machine. Empty = the
# defaults shown. Change them when a port is already taken locally (e.g. a
# system Postgres on 5432); the Tiltfile points the host API/workers at the
# same ports. *_BIND_ADDR=127.0.0.1 keeps a service off the network.
# Per-machine extras (networks, labels) go in the gitignored
# docker-compose.local.yml, which the Tiltfile merges when present.
# Defaults: bind 0.0.0.0; postgres 5432, redis 6379, nginx edge 80;
# GARAGE_ADMIN_BIND_ADDR is the Garage admin API (:3903).
POSTGRES_BIND_ADDR=
POSTGRES_HOST_PORT=
REDIS_BIND_ADDR=
REDIS_HOST_PORT=
GARAGE_ADMIN_BIND_ADDR=
EDGE_HOST_PORT=

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WORKER_TOKEN=

# ── Local dev only ───────────────────────────────────────────────────────
# Set to true to skip startup secret validation (never use in production).
ALLOW_INSECURE_DEFAULTS=false

# ── MLflow tracking ──────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
# Browser-side: baked into the frontend bundle at build time (Vite var), so the
# model-page "MLflow run" link resolves. VM devs must set this to their VM host.
VITE_MLFLOW_URL=http://localhost:5000

# ── CVAT (worker-cvat) ───────────────────────────────────────────────────
CVAT_HOST=localhost
CVAT_USERNAME=admin
# Generate with: openssl rand -hex 16
CVAT_PASSWORD=
# Shared secret CVAT signs review-completion webhooks with (HMAC-SHA256).
# Generate with: openssl rand -hex 32
CVAT_WEBHOOK_SECRET=
CVAT_PUBLIC_URL=http://localhost:8080

# ── API internal ─────────────────────────────────────────────────────────
# Derived from above — used in docker-compose
DATABASE_URL=postgresql+asyncpg://cvops:${POSTGRES_PASSWORD}@postgres:5432/cvops
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=${GARAGE_DEFAULT_ACCESS_KEY}
S3_SECRET_KEY=${GARAGE_DEFAULT_SECRET_KEY}
S3_BUCKET=${GARAGE_DEFAULT_BUCKET}
S3_REGION=garage

# ── Observability (--profile observability) ──────────────────────────────
# Generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
POSTGRES_EXPORTER_DSN=postgresql://cvops:${POSTGRES_PASSWORD}@postgres:5432/cvops?sslmode=disable
REDIS_EXPORTER_ADDR=redis://redis:6379

# Vite HMR websocket port the browser dials. Empty = 80 (the nginx edge).
# `auto` = the page's own port — use it when :80 on this host is not CVOps.
VITE_HMR_CLIENT_PORT=

# ── Docker socket access ─────────────────────────────────────────────────
# Group id of the host's `docker` group. worker-cvat (non-root) and nuclio are
# added to it so they can use /var/run/docker.sock. It differs per machine:
#   getent group docker | cut -d: -f3
# Empty = 962.
DOCKER_GID=

# ── Keycloak: login server (--profile auth) ──────────────────────────────
# See docs/keycloak.md. Login settings have NO defaults: Tilt and the
# keycloak container both refuse to start until each one below is filled in.
#
# Run Keycloak at all? true = start it with `tilt up`; false = don't.
CVOPS_ENABLE_KEYCLOAK=
# Where the BROWSER reaches Keycloak (tokens are issued with this as `iss`).
# Local: http://localhost:8081. Dev VM: http://<dev-vm>:8081
KEYCLOAK_PUBLIC_URL=
# Where the browser reaches the CVOps app. Keycloak only redirects back to
# exactly this origin (plus the Vite dev server on :5173), never anywhere else.
# Local: http://localhost. Dev VM: http://<dev-vm>
CVOPS_APP_ORIGIN=
# Keycloak admin console login (user `admin`), at KEYCLOAK_PUBLIC_URL.
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin
# Password of the seed users alice@example.com (owner) and bob@example.com
# (editor) in the demo org.
KEYCLOAK_SEED_USER_PASSWORD=change_me_keycloak_seed
# Secret of the `cvops-worker` service-account client (worker → API auth).
KEYCLOAK_WORKER_CLIENT_SECRET=change_me_keycloak_worker
# (Tilt replaces change_me_* values with random secrets on first run.)
#
# ── Sign in with Google / GitHub ──
# Each provider needs an "OAuth app" you create in its console. That app gives
# you two values:
#   *_CLIENT_ID      The app's public identifier. It is not a password (it
#                    appears in the browser's address bar during login), but
#                    keep it together with its secret.
#   *_CLIENT_SECRET  The app's PASSWORD: it proves to Google/GitHub that the
#                    request really comes from your Keycloak. Never commit,
#                    paste or share it; if it leaks, regenerate it in the
#                    provider's console.
#   *_LOGIN_ENABLED  true  = show the "Sign in with ..." button (needs both
#                            values above);
#                    false = hide it (the two values can stay empty).
# Callback / redirect URL to enter when creating the app:
#   <KEYCLOAK_PUBLIC_URL>/realms/cvops/broker/google/endpoint
#   <KEYCLOAK_PUBLIC_URL>/realms/cvops/broker/github/endpoint
# Google: console.cloud.google.com → APIs & Services → Credentials →
#         Create credentials → OAuth client ID → Web application.
# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App
#         (for the team: create it under the Hozi-AI org instead).
# Keycloak reads these only when it first creates the realm; after changing
# them, reset Keycloak's database (docs/keycloak.md → "Reset").
GOOGLE_LOGIN_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_LOGIN_ENABLED=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
