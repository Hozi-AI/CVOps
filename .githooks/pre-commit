#!/bin/sh
# ── pre-commit (git provider) ──────────────────────────────────────────────
# Runs available linters on staged files only.
# Fails fast on first linter error.
# Warns and skips if tools are not installed.
#
# jj has no staging step, so this hook is git-only. Under jj, run linting via
# `jj util exec -- <linter>` or rely on CI; convention checks (messages +
# bookmark names) are covered by `jj check` / `jj push`.

PASS=true
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
  exit 0
fi

# ── Python ─────────────────────────────────────────────────────────────────
PY_FILES=$(printf '%s\n' $STAGED | grep -E '\.py$' || true)

if [ -n "$PY_FILES" ]; then
  # ruff — lint + format check. Only services/api declares a ruff config (and CI
  # lints just that tree), so the check is scoped to it to match CI.
  RUFF_PY_FILES=$(printf '%s\n' $PY_FILES | grep -E '^services/api/' || true)
  RUFF_CONFIG="services/api/pyproject.toml"
  RUFF_BIN=""
  if [ -x "services/api/.venv/bin/ruff" ]; then
    RUFF_BIN="services/api/.venv/bin/ruff"   # pinned version from the api dev extras
  elif command -v ruff >/dev/null 2>&1; then
    RUFF_BIN="ruff"
  fi

  if [ -n "$RUFF_PY_FILES" ]; then
    if [ -z "$RUFF_BIN" ]; then
      printf '\n  \033[33mpre-commit: ruff not installed — skipping Python lint/format\033[0m\n'
      printf '  Run: pip install -e "services/api[dev]"\n\n'
    else
      printf '%s\n' $RUFF_PY_FILES | xargs "$RUFF_BIN" check --config "$RUFF_CONFIG" 2>&1
      if [ $? -ne 0 ]; then
        printf '\n  \033[31mpre-commit: ruff check failed\033[0m\n\n'
        PASS=false
      fi

      printf '%s\n' $RUFF_PY_FILES | xargs "$RUFF_BIN" format --check --config "$RUFF_CONFIG" 2>&1
      if [ $? -ne 0 ]; then
        printf '\n  \033[31mpre-commit: ruff format check failed\033[0m\n'
        printf '  Run: ruff format --config %s <files>\n\n' "$RUFF_CONFIG"
        PASS=false
      fi
    fi
  fi

  # mypy — type check (non-blocking warning if config missing)
  if command -v mypy >/dev/null 2>&1; then
    if [ -f "mypy.ini" ] || [ -f "setup.cfg" ] || [ -f "pyproject.toml" ]; then
      printf '%s\n' $PY_FILES | xargs mypy --ignore-missing-imports 2>&1
      if [ $? -ne 0 ]; then
        printf '\n  \033[31mpre-commit: mypy type check failed\033[0m\n\n'
        PASS=false
      fi
    fi
  fi
fi

# ── TypeScript / JavaScript ────────────────────────────────────────────────
TS_FILES=$(printf '%s\n' $STAGED | grep -E '^services/frontend/.*\.(ts|tsx|js|jsx)$' || true)

if [ -n "$TS_FILES" ]; then
  # package.json / tsconfig.json / eslint config all live in services/frontend,
  # so run the same checks as `npm run lint` / `npm run typecheck` from there.
  if [ ! -x "services/frontend/node_modules/.bin/eslint" ] || [ ! -x "services/frontend/node_modules/.bin/tsc" ]; then
    printf '\n  \033[33mpre-commit: frontend deps not installed — skipping ESLint/tsc\033[0m\n'
    printf '  Run: (cd services/frontend && npm install)\n\n'
  else
    # ESLint (staged files only; paths made relative to the frontend dir)
    FE_FILES=$(printf '%s\n' $TS_FILES | sed 's|^services/frontend/||')
    (cd services/frontend && printf '%s\n' $FE_FILES | xargs npx eslint --max-warnings 0 --no-warn-ignored 2>&1)
    if [ $? -ne 0 ]; then
      printf '\n  \033[31mpre-commit: ESLint check failed\033[0m\n\n'
      PASS=false
    fi

    # TypeScript compiler check (tsc --noEmit) — whole project, like CI
    (cd services/frontend && npx tsc --noEmit 2>&1)
    if [ $? -ne 0 ]; then
      printf '\n  \033[31mpre-commit: TypeScript type check failed\033[0m\n\n'
      PASS=false
    fi
  fi
fi

# ── YAML / JSON ────────────────────────────────────────────────────────────
YML_FILES=$(printf '%s\n' $STAGED | grep -E '\.(yaml|yml)$' || true)

if [ -n "$YML_FILES" ] && command -v python3 >/dev/null 2>&1; then
  for f in $YML_FILES; do
    python3 -c "import yaml, sys; yaml.safe_load(open('$f'))" 2>&1
    if [ $? -ne 0 ]; then
      printf '\n  \033[31mpre-commit: YAML parse error in %s\033[0m\n\n' "$f"
      PASS=false
    fi
  done
fi

JSON_FILES=$(printf '%s\n' $STAGED | grep -E '\.json$' | grep -v 'package-lock.json' || true)

if [ -n "$JSON_FILES" ] && command -v python3 >/dev/null 2>&1; then
  for f in $JSON_FILES; do
    python3 -m json.tool "$f" >/dev/null 2>&1
    if [ $? -ne 0 ]; then
      printf '\n  \033[31mpre-commit: JSON parse error in %s\033[0m\n\n' "$f"
      PASS=false
    fi
  done
fi

# ── trailing whitespace & debug artifacts ──────────────────────────────────
if printf '%s\n' $STAGED | grep -qE '\.(py|ts|tsx|js|jsx|yaml|yml|md)$'; then
  BAD=$(git diff --cached --check 2>&1 || true)
  if [ -n "$BAD" ]; then
    printf '\n  \033[33mpre-commit: trailing whitespace detected\033[0m\n'
    printf '%s\n' "$BAD"
    printf '\n'
    PASS=false
  fi
fi

if [ "$PASS" = "false" ]; then
  printf '\n  \033[31mGIT HOOK: pre-commit — fix errors above before committing.\033[0m\n\n'
  exit 1
fi

exit 0
